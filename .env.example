# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free

# Application
ENVIRONMENT=development
VECTOR_STORE_TYPE=local
CATALOG_PATH=./data/fashion_catalog_5lakh.csv
TOP_K_RETRIEVAL=25
TOP_N_RERANK=6

# ChromaDB
CHROMA_PERSIST_DIR=./data/vector_indices/chroma
CHROMA_PRODUCT_COLLECTION=fashion_catalog_5lakh
CHROMA_KB_COLLECTION=fashion_domain_kb

# Ingestion
INGEST_BATCH_SIZE=16
INGEST_MAX_RETRIES=8
INGEST_REQUEST_INTERVAL_SECONDS=3
INGEST_HTTP_TIMEOUT_SECONDS=180

# Dense ingestion uses OpenRouter embeddings. ChromaDB handles metadata filtering.